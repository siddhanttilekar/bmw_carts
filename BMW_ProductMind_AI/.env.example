# BMW_CAST - ProductMind AI: environment variables (template, no real values).
# The app reads environment variables only; it does not load a .env file automatically.
# Export them in your shell before `streamlit run app.py`. Never commit a real key.

# --- Paths (optional; relative paths resolve from the project root) ---
PRODUCTMIND_DATA_DIR=data
PRODUCTMIND_DB_PATH=database/productmind.db
PRODUCTMIND_REPORTS_DIR=reports

# --- AI features (optional; everything else works without them) ---
OPENAI_API_KEY=                          # your own OpenAI key - never commit it
PRODUCTMIND_LLM_PROVIDER=openai          # openai (default) | anthropic - no automatic fallback
PRODUCTMIND_ALLOW_EXTERNAL_LLM=0         # set to 1 to allow requests to the AI provider
PRODUCTMIND_LLM_MODEL=gpt-5.6-luna       # default OpenAI model
PRODUCTMIND_LLM_EFFORT=low               # OpenAI reasoning effort
PRODUCTMIND_MAX_API_SPEND_USD=26         # application budget (estimated from token usage, not a billing cap)
PRODUCTMIND_DEBATE_ALLOWANCE_USD=0       # optional owner-set BMW_CAST Bot allowance (0 = none)

# --- Rarely needed ---
# ANTHROPIC_API_KEY=                     # only if PRODUCTMIND_LLM_PROVIDER=anthropic
# PRODUCTMIND_LLM_BATCH_SIZE=10
# PRODUCTMIND_LLM_FALLBACKS=0

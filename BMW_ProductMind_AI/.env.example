# Optional overrides (relative paths resolve from the project root).
# Export them in your shell before running; defaults shown.
PRODUCTMIND_DATA_DIR=data
PRODUCTMIND_DB_PATH=database/productmind.db
PRODUCTMIND_REPORTS_DIR=reports

# External LLM use (Parts 2 and 4) is disabled unless explicitly authorised.
# PRODUCTMIND_ALLOW_EXTERNAL_LLM=false
# PRODUCTMIND_LLM_PROVIDER=openai          # openai (default) | anthropic - never an automatic fallback
# PRODUCTMIND_LLM_MODEL=gpt-5.6-luna       # default for openai
# PRODUCTMIND_LLM_EFFORT=low               # OpenAI reasoning effort
# PRODUCTMIND_MAX_API_SPEND_USD=26         # application budget (estimate-based, not a billing cap)
# OPENAI_API_KEY=                      # never commit a key
# ANTHROPIC_API_KEY=                       # only if PRODUCTMIND_LLM_PROVIDER=anthropic
# PRODUCTMIND_LLM_FALLBACKS=0   # 1 = allow server-side fallback to another model
PRODUCTMIND_LLM_PROVIDER=openai
PRODUCTMIND_LLM_MODEL=gpt-5.6-luna
PRODUCTMIND_ALLOW_EXTERNAL_LLM=1
PRODUCTMIND_MAX_API_SPEND_USD=26